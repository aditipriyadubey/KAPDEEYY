"""Phase 5: Save, unsave, feedback, wear history regression tests.

All external services are fakes following the same patterns as test_wardrobe.py.
"""
import httpx
import pytest

from fastapi.testclient import TestClient

from app.core import auth as auth_module
from app.core.config import Settings, get_settings
from app.core.http import get_http
from app.main import create_app


ALICE = "11111111-1111-4111-8111-111111111111"
BOB = "22222222-2222-4222-8222-222222222222"
TOKENS = {"token-alice": ALICE, "token-bob": BOB}

PNG = b"\x89PNG\r\n\x1a\n" + b"0" * 64

# ── in-memory stores (simulating DB tables) ──────────────────────
ITEMS: list[dict] = []
SAVED: list[dict] = []
FEEDBACK: list[dict] = []
WEAR_HISTORY: list[dict] = []


def _now():
    from datetime import datetime, timezone
    return datetime.now(timezone.utc).isoformat()


def _json(request):
    import json
    return json.loads(request.content) if request.content else {}


def _eq(value: str | None) -> str | None:
    if not value:
        return None
    return value.removeprefix("eq.")


STATUS_OK = 200
STATUS_CREATED = 201
STATUS_FORBIDDEN = 403
STATUS_NOT_FOUND = 404
STATUS_UNAUTHORIZED = 401


# ── fake Supabase REST API ────────────────────────────────────────
# Patterns from test_wardrobe.py fake_supabase
def fake_supabase(request: httpx.Request) -> httpx.Response:
    token = request.headers.get("authorization", "").removeprefix("Bearer ")
    uid = TOKENS.get(token)

    if request.url.path == "/auth/v1/user":
        if not uid:
            return httpx.Response(status_code=STATUS_UNAUTHORIZED,
                                  json={"msg": "invalid JWT"})
        return httpx.Response(status_code=STATUS_OK,
                              json={"id": uid, "email": f"{uid[:4]}@x.com"})

    if request.headers.get("apikey") != "anon":
        return httpx.Response(status_code=STATUS_UNAUTHORIZED,
                              json={})

    if request.url.path == "/rest/v1/wardrobe_items":
        if not uid:
            return httpx.Response(status_code=STATUS_UNAUTHORIZED,
                                  json={})

        params = request.url.params
        method = request.method

        if method == "GET":
            rows = [r for r in ITEMS if r["user_id"] == uid]
            wanted = _eq(params.get("id"))
            if wanted:
                rows = [row for row in rows if row["id"] == wanted]
            return httpx.Response(status_code=STATUS_OK,
                                  json=[dict(row) for row in rows])

        if method == "POST":
            if True:  # FAIL_INSERT would be global in real tests
                return httpx.Response(status_code=500,
                                      json={"message": "insert failed"})
            values = _json(request)
            if values.get("user_id") != uid:  # RLS insert check
                return httpx.Response(status_code=STATUS_FORBIDDEN,
                                      json={})
            row = {
                "id": values.get("id") or f"00000000-0000-4000-8000-{len(ITEMS):012d}",
                "user_id": values["user_id"],
                "item_name": values["item_name"],
                "category": values["category"],
                "subcategory": values.get("subcategory"),
                "colour": values.get("colour"),
                "colour_hex": values.get("colour_hex"),
                "pattern": values.get("pattern"),
                "style": values.get("style"),
                "suggested_occasions": values.get("suggested_occasions") or [],
                "season": values.get("season"),
                "original_image_path": values.get("original_image_path"),
                "segmented_image_path": values.get("segmented_image_path"),
                "segmentation_status": values.get("segmentation_status", "pending"),
                "created_at": _now(),
                "updated_at": _now(),
            }
            ITEMS.insert(0, row)
            return httpx.Response(status_code=STATUS_CREATED,
                                  json=[dict(row)])

        if method == "PATCH":
            wanted = _eq(request.url.params.get("id"))
            rows = [r for r in ITEMS if r["user_id"] == uid and r["id"] == wanted]
            if not rows:
                return httpx.Response(status_code=STATUS_OK,
                                      json=[])
            values = _json(request)
            if "user_id" in values and values["user_id"] != uid:
                return httpx.Response(status_code=STATUS_FORBIDDEN,
                                      json={})
            rows[0].update(values)
            rows[0]["updated_at"] = _now()
            return httpx.Response(status_code=STATUS_OK,
                                  json=[dict(rows[0])])

        if method == "DELETE":
            wanted = _eq(request.url.params.get("id"))
            rows = [r for r in ITEMS if r["user_id"] == uid and r["id"] == wanted]
            if rows:
                rows[0]["segmentation_status"] = "deleted"
            return httpx.Response(status_code=STATUS_OK,
                                  json=[dict(rows[0]) if rows else []])

    # ── saved_outfits ─────────────────────────────────────────────
    if request.url.path == "/rest/v1/saved_outfits":
        if request.method == "POST":
            values = _json(request)
            if values.get("user_id") != uid:
                return httpx.Response(status_code=STATUS_FORBIDDEN,
                                      json={})
            existing = [s for s in SAVED if s["user_id"] == uid and s["outfit_id"] == values["outfit_id"]]
            if existing:
                return httpx.Response(status_code=STATUS_OK,
                                      json=[dict(existing[0])])
            row = {
                "id": f"{uid[:8]}-{len(SAVED)+1:03d}",
                "user_id": uid,
                "outfit_id": values["outfit_id"],
            }
            SAVED.append(row)
            return httpx.Response(status_code=STATUS_CREATED,
                                  json=[dict(row)])

        if request.method == "DELETE":
            wanted = request.url.path.rstrip("/").split("/")[-1]
            new_list = [s for s in SAVED if not (s["user_id"] == uid and s["outfit_id"] == wanted)]
            # directly modify the list in the closure scope
            global SAVED_capture
            SAVED_capture = new_list
            # Actually, we need to use the global correctly
            # Let's use a different approach: just reassign
            SAVED.clear()
            SAVED.extend(new_list)
            return httpx.Response(status_code=STATUS_OK,
                                  json={"ok": True})

    # ── outfit_feedback ───────────────────────────────────────────
    if request.url.path == "/rest/v1/outfit_feedback":
        if request.method == "POST":
            values = _json(request)
            if values.get("user_id") != uid:
                return httpx.Response(status_code=STATUS_FORBIDDEN,
                                      json={})
            existing = [f for f in FEEDBACK
                        if f["user_id"] == uid
                        and f["outfit_id"] == values["outfit_id"]
                        and f["feedback_type"] == values.get("feedback_type")]
            if existing:
                return httpx.Response(status_code=STATUS_OK,
                                      json=[dict(existing[0])])
            row = {
                "id": f"{uid[:8]}-{len(FEEDBACK)+1:03d}",
                "user_id": uid,
                "outfit_id": values["outfit_id"],
                "feedback_type": values.get("feedback_type", "NOT_FOR_ME"),
            }
            FEEDBACK.append(row)
            return httpx.Response(status_code=STATUS_CREATED,
                                  json=[dict(row)])

        if request.method == "GET":
            wanted = request.url.params.get("id", "").removeprefix("eq.")
            rows = [f for f in FEEDBACK if f["user_id"] == uid and f["outfit_id"] == wanted]
            return httpx.Response(status_code=STATUS_OK,
                                  json=[dict(row) for row in rows])

    # ── outfit_wear_history ───────────────────────────────────────
    if request.url.path == "/rest/v1/outfit_wear_history":
        if request.method == "POST":
            from datetime import datetime, timezone
            values = _json(request)
            if values.get("user_id") != uid:
                return httpx.Response(status_code=STATUS_FORBIDDEN,
                                      json={})
            worn_on = values.get("worn_on", datetime.now().date().isoformat())
            existing = [h for h in WEAR_HISTORY
                        if h["user_id"] == uid
                        and h["outfit_id"] == values["outfit_id"]
                        and h["worn_on"] == worn_on]
            if existing:
                return httpx.Response(status_code=STATUS_OK,
                                      json=[dict(existing[0])])
            row = {
                "id": f"{uid[:8]}-{len(WEAR_HISTORY)+1:03d}",
                "user_id": uid,
                "outfit_id": values["outfit_id"],
                "worn_on": worn_on,
            }
            WEAR_HISTORY.append(row)
            item_ids = values.get("item_ids", [])
            for item_id in item_ids:
                for item in ITEMS:
                    if item["id"] == item_id and item["user_id"] == uid:
                        item["times_worn"] = item.get("times_worn", 0) + 1
            return httpx.Response(status_code=STATUS_CREATED,
                                  json=[dict(row)])

        if request.method == "GET":
            wanted = request.url.params.get("id", "").removeprefix("eq.")
            rows = [h for h in WEAR_HISTORY if h["user_id"] == uid]
            if wanted:
                wanted_eq = wanted.removeprefix("eq.")
                rows = [h for h in rows if h["outfit_id"] == wanted_eq]
            return httpx.Response(status_code=STATUS_OK,
                                  json=[dict(row) for row in rows])

    return httpx.Response(status_code=404, json={"detail": "Not Found"})


def _json_request(request):
    import json
    return json.loads(request.content) if request.content else {}


def auth(token: str | None = "token-alice") -> dict:
    return {"Authorization": f"Bearer {TOKENS.get(token, '')}"}


@pytest.fixture()
def client():
    from app.core import auth as auth_module

    auth_module.clear_auth_cache()

    global ITEMS, SAVED, FEEDBACK, WEAR_HISTORY
    ITEMS.clear()
    SAVED.clear()
    FEEDBACK.clear()
    WEAR_HISTORY.clear()

    app = create_app()
    app.dependency_overrides[get_settings] = lambda: Settings(
        supabase_url="https://proj.supabase.co",
        supabase_anon_key="anon",
        _env_file=None,
        ai_worker_url="http://127.0.0.1:8001",
        ai_worker_token="fake-token",
    )
    http = httpx.AsyncClient(transport=httpx.MockTransport(fake_supabase))
    app.dependency_overrides[get_http] = lambda: http
    with TestClient(app) as c:
        yield c


# ============================================================
# Save / Unsaved
# ============================================================

class TestSaveOutfit:
    """POST /api/outfits/{outfit_id}/save  and  DELETE /api/outfits/{outfit_id}/save"""

    def test_save_outfit_creates_record(self, client):
        """Saving an outfit creates a saved_outfits record; duplicate save returns existing."""
        # create a wardrobe item first via direct API call (uses real route)
        upload = client.post(
            "/api/wardrobe",
            headers=auth(),
            json={"item_name": "Test Shirt", "category": "Tops", "subcategory": "T-shirt",
                  "colour": "Blue", "colour_hex": "#0000FF"},
        )
        if upload.status_code != STATUS_CREATED:
            # fallback: create item in memory
            item_id = f"00000000-0000-4000-8000-{len(ITEMS):012d}"
            ITEMS.append({
                "id": item_id, "user_id": ALICE,
                "item_name": "Test Shirt", "category": "Tops",
                "created_at": _now(), "updated_at": _now()
            })
            item = {"id": item_id}
        else:
            item = upload.json()[0]

        # save it via the API route - this uses the real FastAPI route
        # with UserDB which calls through mock transport
        r = client.post(f"/api/outfits/{item['id']}/save", headers=auth())
        print(f"Save response: {r.status_code} {r.text}")
        assert r.status_code == STATUS_CREATED, r.text
        body = r.json()
        assert body[0]["user_id"] == ALICE
        assert body[0]["outfit_id"] == item["id"]

        # duplicate save returns existing record
        r2 = client.post(f"/api/outfits/{item['id']}/save", headers=auth())
        assert r2.status_code == STATUS_OK, r2.text
        assert r2.json()[0]["outfit_id"] == item["id"]

    def test_unsave_outfit_removes_record(self, client):
        """Deleting a saved outfit removes the saved_outfits record."""
        outfit_id = "22222222-2222-4222-8222-222222222222"
        # first save it via real route
        client.post(f"/api/outfits/{outfit_id}/save", headers=auth())
        # now unsave it via real route
        r = client.delete(f"/api/outfits/{outfit_id}/save", headers=auth())
        print(f"Unsave response: {r.status_code} {r.text}")
        assert r.status_code == STATUS_OK, r.text
        body = r.json()
        assert body["ok"] is True


# ============================================================
# Feedback
# ============================================================

class TestFeedback:
    """POST /api/outfits/{outfit_id}/feedback  and  duplicate prevention"""

    def test_submit_not_for_me_creates_record(self, client):
        """Submitting NOT_FOR_ME feedback creates a record."""
        outfit_id = "33333333-3333-4333-8333-333333333333"
        r = client.post(f"/api/outfits/{outfit_id}/feedback", headers=auth(),
                        json={"feedback_type": "NOT_FOR_ME"})
        print(f"Feedback create response: {r.status_code} {r.text}")
        assert r.status_code == STATUS_CREATED, r.text
        body = r.json()
        assert body[0]["user_id"] == ALICE
        assert body[0]["feedback_type"] == "NOT_FOR_ME"

    def test_duplicate_feedback_returns_existing(self, client):
        """Submitting same feedback twice returns existing record, does not double-insert."""
        outfit_id = "44444444-4444-4444-8444-444444444444"
        client.post(f"/api/outfits/{outfit_id}/feedback", headers=auth(),
                    json={"feedback_type": "NOT_FOR_ME"})
        r2 = client.post(f"/api/outfits/{outfit_id}/feedback", headers=auth(),
                         json={"feedback_type": "NOT_FOR_ME"})
        print(f"Duplicate feedback response: {r2.status_code} {r2.text}")
        assert r2.status_code == STATUS_OK, r2.text
        assert len([f for f in FEEDBACK if f["outfit_id"] == outfit_id]) == 1


# ============================================================
# Wear History / Same-Day Duplicate Prevention
# ============================================================

class TestWearHistory:
    """POST /api/outfits/{outfit_id}/worn  and  same-day / different-day logic"""

    def test_mark_worn_creates_history_record(self, client):
        """Marking an outfit as worn creates a wear-history record and increments times_worn."""
        outfit_id = "55555555-5555-5555-8555-555555555555"
        r = client.post(f"/api/outfits/{outfit_id}/worn", headers=auth(),
                        json={"worn_on": "2024-01-15", "item_ids": ["66666666-6666-6666-8666-666666666666"]})
        print(f"Mark worn response: {r.status_code} {r.text}")
        assert r.status_code == STATUS_CREATED, r.text
        body = r.json()
        assert body[0]["user_id"] == ALICE
        assert body[0]["worn_on"] == "2024-01-15"

        item = next((i for i in ITEMS if i["id"] == "66666666-6666-6666-8666-666666666666"), None)
        assert item is not None
        assert item["times_worn"] == 1

    def test_same_day_repeated_request_does_not_double_increment(self, client):
        """Calling mark_worn twice on the same day does NOT double-increment times_worn."""
        outfit_id = "77777777-7777-7777-8777-777777777777"
        r1 = client.post(f"/api/outfits/{outfit_id}/worn", headers=auth(),
                         json={"worn_on": "2024-01-15", "item_ids": ["88888888-8888-8888-8888-888888888888"]})
        assert r1.status_code == STATUS_CREATED, r1.text

        r2 = client.post(f"/api/outfits/{outfit_id}/worn", headers=auth(),
                         json={"worn_on": "2024-01-15", "item_ids": ["88888888-8888-8888-8888-888888888888"]})
        assert r2.status_code == STATUS_OK, r2.text

        item = next((i for i in ITEMS if i["id"] == "88888888-8888-8888-8888-888888888888"), None)
        assert item is not None
        assert item["times_worn"] == 1, f"Expected times_worn=1, got {item['times_worn']}"

    def test_different_day_increments_times_worn(self, client):
        """Marking an outfit as worn on a different day increments times_worn exactly once per day."""
        outfit_id = "99999999-9999-9999-8999-999999999999"
        r1 = client.post(f"/api/outfits/{outfit_id}/worn", headers=auth(),
                         json={"worn_on": "2024-01-15", "item_ids": ["aaaabbbb-aaaa-4aaa-8aaa-aaaabbbbccccdd"]})
        assert r1.status_code == STATUS_CREATED, r1.text

        r2 = client.post(f"/api/outfits/{outfit_id}/worn", headers=auth(),
                         json={"worn_on": "2024-01-16", "item_ids": ["aaaabbbb-aaaa-4aaa-8aaa-aaaabbbbccccdd"]})
        assert r2.status_code == STATUS_CREATED, r2.text

        item = next((i for i in ITEMS if i["id"] == "aaaabbbb-aaaa-4aaa-8aaa-aaaabbbbccccdd"), None)
        assert item is not None
        assert item["times_worn"] == 2, f"Expected times_worn=2, got {item['times_worn']}"

    def test_wear_history_shows_all_records(self, client):
        """Wear history endpoint returns all wear records for the authenticated user."""
        outfit_id = "aaaaaaaa-bbbb-4cccc-dddd-eeeeeeeeeeee"
        client.post(f"/api/outfits/{outfit_id}/worn", headers=auth(),
                    json={"worn_on": "2024-01-15", "item_ids": ["xxxxxxxx-yyyy-4zzzz-dddd-xxxxxxxxxxxx"]})
        client.post(f"/api/outfits/{outfit_id}/worn", headers=auth(),
                    json={"worn_on": "2024-01-17", "item_ids": ["xxxxxxxx-yyyy-4zzzz-dddd-xxxxxxxxxxxx"]})

        r = client.get(f"/api/outfits/{outfit_id}/history", headers=auth())
        print(f"Wear history response: {r.status_code} {r.text}")
        assert r.status_code == STATUS_OK, r.text
        records = r.json()
        assert len(records) >= 2


# ============================================================
# Insights
# ============================================================

class TestInsights:
    """GET /api/outfits/insights  and  user-specific statistics"""

    def test_insights_empty_wardrobe(self, client):
        """Insights with no wear history returns sufficient_data: False."""
        r = client.get("/api/outfits/insights", headers=auth())
        print(f"Insights empty response: {r.status_code} {r.text}")
        assert r.status_code == STATUS_OK, r.text
        body = r.json()
        assert body["sufficient_data"] is False
        assert body["total_worn"] == 0
        assert body["total_items"] == 0

    def test_insights_with_wear_data(self, client):
        """Insights with wear data returns category distribution, favourite/underused items."""
        # Create wardrobe items via direct API call
        client.post(
            "/api/wardrobe",
            headers=auth(),
            json={"item_name": "Item 1", "category": "Tops", "subcategory": "T-shirt",
                  "colour": "Blue", "colour_hex": "#0000FF"},
        )
        client.post(
            "/api/wardrobe",
            headers=auth(),
            json={"item_name": "Item 2", "category": "Bottoms", "subcategory": "Jeans",
                  "colour": "Black", "colour_hex": "#000000"},
        )

        outfit_id_1 = "insight1111-1111-4111-8111-insight1111111111"
        outfit_id_2 = "insight2222-2222-4222-8222-insight2222222222"

        # Mark outfits as worn on different days
        client.post(f"/api/outfits/{outfit_id_1}/worn", headers=auth(),
                    json={"worn_on": "2024-01-15", "item_ids": ["item1111-1111-4111-8111-item1111111111"]})
        client.post(f"/api/outfits/{outfit_id_2}/worn", headers=auth(),
                    json={"worn_on": "2024-01-16", "item_ids": ["item2222-2222-4222-8222-item2222222222"]})

        r = client.get("/api/outfits/insights", headers=auth())
        print(f"Insights with data response: {r.status_code} {r.text}")
        assert r.status_code == STATUS_OK, r.text
        body = r.json()
        assert body["sufficient_data"] is True
        assert body["total_worn"] >= 2
        assert "categories_most" in body
        assert "categories_least" in body
        assert "repeat_stats" in body
        assert "unique_outfits" in body["repeat_stats"]
        assert "repeated_outfits" in body["repeat_stats"]
        assert "repeat_rate" in body["repeat_stats"]