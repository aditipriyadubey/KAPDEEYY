# ── Frontend (frontend/.env) ─────────────────────────────
VITE_USE_MOCK=true
VITE_API_URL=http://localhost:8000/api
# Phase 2: public values only (anon key is safe in the browser)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Backend (backend/.env) — Phase 2+, NEVER commit ──────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3-vl:4b

# ── Phase 3B: local AI worker (backend/.venv-ai) ─────────
# Gemini classification needs a key in the AI env; it is never exposed to the
# frontend. Leave blank to keep the AI status degraded until configured.
GEMINI_API_KEY=
AI_WORKER_URL=http://127.0.0.1:8001
AI_WORKER_TOKEN=
AI_WORKER_TIMEOUT_SECONDS=120
SEGMENTATION_WEIGHTS_PATH=models/checkpoint_best_total.pth
SEGMENTATION_THRESHOLD=0.25
